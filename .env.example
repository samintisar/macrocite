# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real keys.

# Local Postgres from `docker compose up -d` (matches docker-compose.yml, port 5432).
# If you use docker-compose.port.yml, switch the port to 5433.
DATABASE_URL=postgresql+psycopg://signalbench:signalbench@localhost:5432/signalbench

# Required for `signalbench ingest filings`. SEC requires a real contact email.
SEC_USER_AGENT=SignalBench/0.1 (you@example.com)

# Required for live extract (`signalbench extract --llm together`) and eval
# (`uv run python -m signalbench.eval` / GitHub Actions eval-gate).
# Create a key at https://api.together.ai/settings/api-keys
# Tests inject a fake LLM and never call Together. Leave unset for pytest.
# For CI, add the same value as GitHub Actions secret TOGETHER_API_KEY.
TOGETHER_API_KEY=

# Optional overrides (defaults are in src/signalbench/config.py).
# MODEL_VERSION=deepseek-ai/DeepSeek-V4-Flash-0731
# PROMPT_VERSION=v1
