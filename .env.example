# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real keys.

# Local Postgres from `docker compose up -d` (matches docker-compose.yml).
DATABASE_URL=postgresql+psycopg://signalbench:signalbench@localhost:5432/signalbench

# Required for `signalbench ingest filings`. SEC requires a real contact email.
SEC_USER_AGENT=SignalBench/0.1 (you@example.com)

# Required for live extract: `signalbench extract --llm together`.
# Create a key at https://api.together.ai/settings/api-keys
# Leave unset (or use --llm fake) for tests/CI.
TOGETHER_API_KEY=

# Optional overrides (defaults are in src/signalbench/config.py).
# MODEL_VERSION=deepseek-ai/DeepSeek-V4-Flash-0731
# PROMPT_VERSION=v1
