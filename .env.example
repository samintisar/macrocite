# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real keys.

# Local Postgres from `docker compose up -d` (matches docker-compose.yml, port 5432).
# If you use docker-compose.port.yml, switch the port to 5433.
DATABASE_URL=postgresql+psycopg://signalbench:signalbench@localhost:5432/signalbench

# Required for `signalbench ingest filings`. SEC requires a real contact email.
SEC_USER_AGENT=SignalBench/0.1 (you@example.com)

# Required for `signalbench ingest news` and the upcoming-earnings calendar.
# Free key: https://finnhub.io/register  (free tier: ~1 year of company news, 60 calls/min)
FINNHUB_API_KEY=

# Optional overrides (defaults are in src/signalbench/config.py).
# PRICE_HISTORY_START=2010-01-01
# FILINGS_BACKFILL_START=2016-01-01
